    <Row Language="zh_Hans_CN" Tag="LOC_MC_NOTIFY_NEW_GOVERNMENT" Text="首次采用新政体：获得 1 点总督点数"/>
    <Row Language="zh_Hans_CN" Tag="LOC_MC_NOTIFY_RED_ARMY_JOINED" Text="红军会师：获得一个红军"/>
