    <Row Language="zh_Hans_CN" Tag="LOC_MC_NOTIFY_TECH_UNLOCKED" Text="中国化：尤里卡早已触发，直接解锁科技 — {1}"/>
    <Row Language="zh_Hans_CN" Tag="LOC_MC_NOTIFY_CIVIC_BOOSTED" Text="中国化：获得一项鼓舞 — {1}"/>
    <Row Language="zh_Hans_CN" Tag="LOC_MC_NOTIFY_CIVIC_UNLOCKED" Text="中国化：鼓舞早已触发，直接解锁市政 — {1}"/>
