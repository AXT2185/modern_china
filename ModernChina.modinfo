  <ActionCriteria>
    <Criteria id="leaderPlayable">
      <LeaderPlayable>Players:Expansion1_Players::LEADER_MAO,Players:Expansion2_Players::LEADER_MAO,Players:Expansion1_Players::LEADER_QIAN_XUESEN,Players:Expansion2_Players::LEADER_QIAN_XUESEN</LeaderPlayable>
    </Criteria>
    <Criteria id="Expansion1">
      <GameCoreInUse>Expansion1,Expansion2</GameCoreInUse>
    </Criteria>
    <Criteria id="Expansion2">
